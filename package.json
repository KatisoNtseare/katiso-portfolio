{
  "name": "katiso-ntseare-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --conditions=react-server --test tests/auth.test.mjs tests/cloudinary.test.mjs tests/email-service.test.mjs tests/contact-validation.test.mjs tests/media-security.test.mjs",
    "test:integration": "node --conditions=react-server --test tests/crud-and-publishing.test.mjs tests/e2e-integration.test.mjs",
    "cloudinary:cleanup": "node --conditions=react-server --env-file-if-exists=.env.local scripts/cleanup-cloudinary.mjs",
    "email:check": "node --env-file-if-exists=.env.local scripts/check-email.mjs",
    "email:test": "node --env-file-if-exists=.env.local scripts/test-email.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-database.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-database.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.9.1",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.0.2",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.0",
    "typescript": "^5.9.3"
  }
}
