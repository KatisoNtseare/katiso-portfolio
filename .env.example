# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access: create the hash with `npm run admin:hash -- "your-password"`
ADMIN_USERNAME=katiso
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MongoDB. Use MongoDB Atlas or your own MongoDB deployment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=katiso_portfolio

# Cloudinary configuration for project cover images.
# All project cover images are uploaded server-side and stored under: katiso-portfolio/project-pictures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub public profile integration
GITHUB_USERNAME=KatisoNtseare
GITHUB_TOKEN=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form (Resend). The form returns a clear setup error until these are configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Set this after placing your real CV PDF in /public/documents/.
NEXT_PUBLIC_CV_URL=
