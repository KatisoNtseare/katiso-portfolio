# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access: create the hash with `npm run admin:hash -- "your-password"`
ADMIN_USERNAME=katiso
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MongoDB. Use MongoDB Atlas or your own MongoDB deployment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=katiso_portfolio

# Cloudinary configuration for project cover images.
# All project cover images are uploaded server-side and stored under: katiso-portfolio/project-pictures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email delivery configuration for the portfolio contact form.
# 1. Sign up at https://resend.com and create an API key (re_...) with sending access.
# 2. Add and verify your dedicated sending subdomain at https://resend.com/domains (e.g. notify.proit.dev).
#    Using a dedicated subdomain preserves root-domain Zoho Mail MX/SPF records without conflict.
# 3. For initial testing before domain verification, use CONTACT_FROM_EMAIL="onboarding@resend.dev".
#    Note: Resend test sender will only deliver to the email registered on your Resend account.
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=katisontseare@proit.dev
CONTACT_FROM_EMAIL="Katiso Ntseare <portfolio@notify.proit.dev>"

# GitHub public profile integration
GITHUB_USERNAME=KatisoNtseare
GITHUB_TOKEN=
NEXT_PUBLIC_LINKEDIN_URL=

# Set this after placing your real CV PDF in /public/documents/.
NEXT_PUBLIC_CV_URL=
